# Use Node.js as base image
FROM node:18-alpine

# Create app directory
WORKDIR /app

# Install global dependencies
RUN npm install -g typescript ts-node

# Copy package.json first (if you have one)
COPY package*.json ./

# If you don't have a package.json, create a minimal one
RUN if [ ! -f package.json ]; then \
    echo '{"name":"spreadly-test","version":"1.0.0","description":"Test for Spreadly Business Card Scanner","scripts":{"test":"ts-node spreadly_test.ts"},"dependencies":{},"devDependencies":{"typescript":"^4.9.5","ts-node":"^10.9.1","@types/node":"^18.15.0"}}' > package.json; \
    fi

# Install dependencies
RUN npm install

# Copy source files
COPY showbuddy/app/src/showbuddy ./
COPY tests/integration/spreadly_test.ts ./spreadly_test.ts
COPY tests/integration/files/*.png ./


# Create a tsconfig.json file if it doesn't exist
RUN echo '{"compilerOptions":{"target":"es2020","module":"commonjs","esModuleInterop":true,"strict":true,"skipLibCheck":true,"forceConsistentCasingInFileNames":true}}' > tsconfig.json

# Run the test when the container starts
CMD ["npm", "test"]